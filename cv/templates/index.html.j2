<!DOCTYPE html>
<!-- generated by cv/build.py — do not edit; edit cv/cv-data.yaml -->
<html lang="id" data-lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.name }} — {{ site.role[default_lang] }}</title>
<meta name="description" content="{{ site.positioning[default_lang] }}">

<meta property="og:type" content="profile">
<meta property="og:title" content="{{ meta.name }} — {{ site.role[default_lang] }}">
<meta property="og:description" content="{{ site.positioning[default_lang] }}">
<meta property="og:url" content="{{ site.url }}">
<meta property="og:image" content="{{ site.url }}{{ site.photo }}">
<meta property="og:locale" content="id_ID">
<meta property="og:locale:alternate" content="en_US">
<meta name="twitter:card" content="summary">

<link rel="canonical" href="{{ site.url }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%231f4e79'/><text x='16' y='23' font-family='Georgia,serif' font-size='19' fill='white' text-anchor='middle'>K</text></svg>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Spectral:wght@400;500;600&display=swap">

<script type="application/ld+json">{{ jsonld }}</script>

<style>
{% include "_tokens.css.j2" %}

/* ---------- landing-only ------------------------------------------------- */
:root { --gutter-wide: 14rem; }

.page { padding-bottom: var(--s4); }

/* ---------- masthead ----------------------------------------------------- */
.masthead {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 12.5rem;
  gap: var(--s5);
  align-items: start;
  margin-bottom: var(--s6);
}
.masthead h1 {
  /* Upright, not italic: italic serif reads editorial, this should read corporate. */
  font: 600 clamp(2.1rem, 5vw, 3rem)/1.05 var(--serif);
  letter-spacing: -0.015em;
  margin: 0 0 var(--s2);
  text-wrap: balance;
}
.positioning {
  font: 400 clamp(1.0625rem, 2vw, 1.25rem)/1.5 var(--sans);
  color: var(--ink-soft);
  max-width: 34ch;
  margin: 0 0 var(--s3);
  text-wrap: pretty;
}
.credentials {
  font-family: var(--mono);
  font-size: 0.75rem;
  line-height: 1.7;
  color: var(--ink-faint);
  margin: 0 0 var(--s3);
}
.credentials strong { color: var(--ink-soft); font-weight: 500; }

.portrait {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  border-radius: 4px;              /* corporate: square-ish, no glow, no frame */
  border: 1px solid var(--rule);
  background: var(--surface);
}

.cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font: 500 0.8125rem/1 var(--sans);
  letter-spacing: 0.04em;
  padding: 0.75rem 1.25rem;
  border-radius: 4px;
  background: var(--accent);
  color: var(--ground);
  text-decoration: none;
  transition: opacity 0.15s;
}
.cta:hover { opacity: 0.88; }
.cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ---------- trusted by --------------------------------------------------- */
.clients {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  gap: 0.35rem var(--s3);
}
.clients li {
  font-size: 0.875rem;
  color: var(--ink-soft);
  padding: 0.3rem 0;
  border-bottom: 1px solid var(--rule);
}

/* ---------- practice areas ----------------------------------------------- */
/* Same grid rhythm as .entry — a wider left column instead of a date. */
.practice {
  display: grid;
  grid-template-columns: var(--gutter-wide) minmax(0, 1fr);
  gap: 0 var(--s3);
  padding: var(--s2) 0;
  border-bottom: 1px solid var(--rule);
}
.practice:first-of-type { padding-top: 0; }
.practice:last-of-type { border-bottom: 0; padding-bottom: 0; }
.practice h3 {
  font: 600 0.9375rem/1.35 var(--sans);
  margin: 0;
  text-wrap: pretty;
}
.practice p {
  margin: 0;
  color: var(--ink-soft);
  max-width: var(--measure);
  text-wrap: pretty;
}
.evidence {
  display: block;
  margin-top: 0.5rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  line-height: 1.6;
  color: var(--ink-faint);
}

/* ---------- figures ------------------------------------------------------ */
.figures {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  gap: var(--s3);
  margin-bottom: var(--s4);
}
.figure { border-top: 2px solid var(--accent); padding-top: 0.75rem; }
.figure b {
  display: block;
  font: 600 1.875rem/1.1 var(--serif);
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.figure span {
  display: block;
  margin-top: 0.25rem;
  font-size: 0.8125rem;
  color: var(--ink-soft);
  text-wrap: pretty;
}

/* ---------- contact ------------------------------------------------------ */
.contact-list {
  list-style: none;
  margin: 0 0 var(--s4);
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  gap: 0;
}
.contact-list li {
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--rule);
}
.contact-list .k {
  display: block;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 0.15rem;
}
.contact-list a, .contact-list span.v {
  font-size: 0.9375rem;
  color: var(--ink);
  text-decoration: none;
  border-bottom: 1px solid transparent;
}
.contact-list a:hover { color: var(--accent); border-bottom-color: var(--accent); }
.contact-list a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.more {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px solid var(--accent-soft);
}
.more:hover { border-bottom-color: currentColor; }

/* ---------- footer ------------------------------------------------------- */
.foot {
  border-top: 1px solid var(--rule);
  margin-top: var(--s5);
  padding-top: var(--s2);
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem var(--s3);
  align-items: baseline;
  font-size: 0.75rem;
  color: var(--ink-faint);
}
.foot a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--rule); }
.foot a:hover { color: var(--accent); border-bottom-color: var(--accent); }

/* ---------- narrow ------------------------------------------------------- */
@media (max-width: 46rem) {
  .masthead { grid-template-columns: 1fr; gap: var(--s4); }
  .portrait { max-width: 11rem; }
  .practice { grid-template-columns: 1fr; gap: 0.35rem; }
}

@media print {
  .toolbar, .cta { display: none; }
}
</style>
</head>
<body>

<div class="page">

  <div class="toolbar">
    <div class="seg" role="group" aria-label="Bahasa / Language">
      <button type="button" data-set="lang" data-value="id" aria-pressed="true">ID</button>
      <button type="button" data-set="lang" data-value="en" aria-pressed="false">EN</button>
    </div>
    <button type="button" class="iconbtn" id="theme-toggle" aria-label="Ganti tema">
      <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/></svg>
    </button>
    <span class="spacer"></span>
    <a class="toollink" href="cv/"><span data-t="id">CV Lengkap →</span><span data-t="en">Full CV →</span></a>
  </div>

{%- macro refs(e) -%}
  {%- for u in e.links %}<div><a class="ref" href="{{ u }}" target="_blank" rel="noopener">{{ u }}</a></div>{% endfor -%}
{%- endmacro -%}

{%- macro entry(e, lang) -%}
  <div class="entry">
    <div class="when">{% if e.meta %}{{ e.meta[lang] }}{% endif %}</div>
    <div class="what">
      <h3 class="primary">{{ e.primary[lang] }}</h3>
      {%- if e.sub and e.sub[lang] %}<p class="sub">{{ e.sub[lang] }}</p>{% endif %}
      {%- if e.bullets.get(lang) %}
      <ul class="bullets">
        {%- for b in e.bullets[lang] %}<li>{{ b }}</li>{% endfor %}
      </ul>
      {%- endif %}
      {{ refs(e) }}
    </div>
  </div>
{%- endmacro -%}

{% for lang in langs %}
  <article class="doc" data-doc-lang="{{ lang }}" lang="{{ lang }}">

    <header class="masthead">
      <div>
        <h1>{{ meta.name }}</h1>
        <p class="positioning">{{ site.positioning[lang] }}</p>
        <p class="credentials">
          {%- for c in site.credentials[lang] %}<strong>{{ c }}</strong><br>{% endfor -%}
        </p>
        <a class="cta" href="#{{ 'kontak' if lang == 'id' else 'contact' }}">{{ site.cta_label[lang] }}</a>
      </div>
      <img class="portrait" src="{{ site.photo }}" width="200" height="250"
           alt="{{ meta.name }}" loading="eager" decoding="async">
    </header>

    <section>
      <h2>{{ site.t.clients[lang] }}</h2>
      <ul class="clients">
        {%- for c in clients %}<li>{{ c }}</li>{% endfor %}
      </ul>
    </section>

    <section>
      <h2>{{ site.t.practice[lang] }}</h2>
      {%- for p in site.practice %}
      <div class="practice">
        <h3>{{ p.name[lang] }}</h3>
        <p>
          {{ p.what[lang] }}
          <span class="evidence">{{ p.evidence }}</span>
        </p>
      </div>
      {%- endfor %}
    </section>

    <section>
      <h2>{{ site.t.work[lang] }}</h2>
      {%- for e in work %}{{ entry(e, lang) }}{% endfor %}
      <p style="margin-top:var(--s2)"><a class="more" href="cv/">{{ site.t.work_more[lang] }}</a></p>
    </section>

    <section>
      <h2>{{ site.t.research[lang] }}</h2>
      {%- for e in publications %}
      <div class="entry flat">
        <div class="when">{% if e.meta %}{{ e.meta[lang] }}{% endif %}</div>
        <div class="what">{{ e.runs[lang] | runs_html }}{{ refs(e) }}</div>
      </div>
      {%- endfor %}
      <p style="margin-top:var(--s2)"><a class="more" href="{{ meta.links['Google Scholar'] }}" target="_blank" rel="noopener">{{ site.t.scholar[lang] }}</a></p>
    </section>

    <section>
      <h2>{{ site.t.speaking[lang] }}</h2>
      <div class="figures">
        {%- for f in site.t.figures %}
        <div class="figure"><b>{{ stats[f.key] }}</b><span>{{ f.label[lang] }}</span></div>
        {%- endfor %}
      </div>
      {%- for e in talks %}
      <div class="entry flat">
        <div class="when">{% if e.meta %}{{ e.meta[lang] }}{% endif %}</div>
        <div class="what">{{ e.runs[lang] | runs_html }}{{ refs(e) }}</div>
      </div>
      {%- endfor %}
      <p style="margin-top:var(--s2)"><a class="more" href="cv/#talks">{{ site.t.talks_more[lang] }}</a></p>
    </section>

    <section id="{{ 'kontak' if lang == 'id' else 'contact' }}">
      <h2>{{ site.t.contact[lang] }}</h2>
      <p class="positioning" style="font-size:1rem;max-width:var(--measure)">{{ site.cta_body[lang] }}</p>
      <ul class="contact-list">
        <li><span class="k">Email</span><a href="mailto:{{ meta.email }}">{{ meta.email }}</a></li>
        {%- if meta.phone %}
        <li><span class="k">{{ site.t.phone[lang] }}</span><a href="tel:{{ meta.phone | replace(' ', '') }}">{{ meta.phone }}</a></li>
        {%- endif %}
        {%- for name, url in meta.links.items() %}
        <li><span class="k">{{ name }}</span><a href="{{ url }}" target="_blank" rel="noopener">{{ site.t.open[lang] }}</a></li>
        {%- endfor %}
        <li><span class="k">{{ site.t.location[lang] }}</span><span class="v">{{ meta.location[lang] }}</span></li>
      </ul>
    </section>

  </article>
{% endfor %}

  <footer class="foot">
    <span>© {{ year }} {{ meta.name }}</span>
    <a href="cv/"><span data-t="id">CV lengkap</span><span data-t="en">Full CV</span></a>
    <a href="cv/out/resume.id.docx"><span data-t="id">Unduh résumé (ID)</span><span data-t="en">Résumé (ID)</span></a>
    <a href="cv/out/resume.en.docx"><span data-t="id">Unduh résumé (EN)</span><span data-t="en">Résumé (EN)</span></a>
  </footer>

</div>

<script>
(function () {
  var root = document.documentElement;
  var defaults = { lang: '{{ default_lang }}' };

  function read(k) { try { return localStorage.getItem('cv.' + k); } catch (e) { return null; } }
  function write(k, v) { try { localStorage.setItem('cv.' + k, v); } catch (e) {} }

  function apply(key, value) {
    root.setAttribute('data-' + key, value);
    document.querySelectorAll('[data-set="' + key + '"]').forEach(function (b) {
      b.setAttribute('aria-pressed', String(b.dataset.value === value));
    });
    if (key === 'lang') {
      root.setAttribute('lang', value);
      var t = document.getElementById('theme-toggle');
      if (t) t.setAttribute('aria-label', value === 'id' ? 'Ganti tema' : 'Toggle theme');
    }
  }

  Object.keys(defaults).forEach(function (k) { apply(k, read(k) || defaults[k]); });

  var stored = read('theme');
  if (stored) root.setAttribute('data-theme', stored);

  document.querySelectorAll('[data-set]').forEach(function (b) {
    b.addEventListener('click', function () {
      apply(b.dataset.set, b.dataset.value);
      write(b.dataset.set, b.dataset.value);
    });
  });

  document.getElementById('theme-toggle').addEventListener('click', function () {
    var dark = root.getAttribute('data-theme') === 'dark' ||
      (!root.getAttribute('data-theme') &&
        window.matchMedia('(prefers-color-scheme: dark)').matches);
    var next = dark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    write('theme', next);
  });
})();
</script>
</body>
</html>
