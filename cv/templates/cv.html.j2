<!DOCTYPE html>
<!-- generated by cv/build.py — do not edit; edit cv/cv-data.yaml -->
<html lang="en" data-lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.name }} — CV</title>
<meta name="description" content="{{ meta.headline.en }} — full curriculum vitae.">
<meta name="robots" content="index, follow">

<link rel="canonical" href="{{ site.url }}cv/">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%231f4e79'/><text x='16' y='23' font-family='Georgia,serif' font-size='19' fill='white' text-anchor='middle'>K</text></svg>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Spectral:wght@400;500;600&display=swap">

<style>
{% include "_tokens.css.j2" %}

/* ---------- masthead ---------------------------------------------------- */
.masthead { margin-bottom: var(--s4); }
.masthead h1 {
  font: 600 clamp(2rem, 5vw, 2.9rem)/1.05 var(--serif);
  letter-spacing: -0.015em;
  margin: 0 0 0.35rem;
  text-wrap: balance;
}
.headline {
  font: 400 1.0625rem/1.4 var(--serif);
  color: var(--accent);
  margin: 0 0 1.1rem;
}
.contact {
  font-family: var(--mono);
  font-size: 0.75rem;
  color: var(--ink-soft);
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 0.9rem;
  margin-bottom: 0.3rem;
}
.contact a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent-soft); }
.contact a:hover { border-bottom-color: currentColor; }

/* ---------- nested client engagements ----------------------------------- */
.group {
  margin-top: 0.85rem;
  padding-left: 0.9rem;
  border-left: 2px solid var(--rule);
}
.group > h4 {
  font: 500 0.6875rem/1 var(--sans);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin: 0 0 0.6rem;
}
.child { margin-bottom: 0.8rem; }
.child:last-child { margin-bottom: 0; }
.child .primary { font-size: 0.9375rem; }
.child .when {
  display: block;
  padding: 0 0 0.1rem;
  font-size: 0.6875rem;
}

/* ---------- résumé view: mirror resume.*.docx ---------------------------- */
:root[data-view="resume"] [data-tier="2"] { display: none; }
{% for k in academic_only -%}
:root[data-view="resume"] section[data-section="{{ k }}"] { display: none; }
{% endfor -%}
:root[data-view="resume"] section:not(:has(> .entry[data-tier="1"])) { display: none; }
:root[data-view="resume"] .group:not(:has(.child[data-tier="1"])) { display: none; }

@media (max-width: 46rem) {
  .toolbar { justify-content: flex-start; }
}

/* ---------- print -------------------------------------------------------- */
@media print {
  @page { margin: 12mm 13mm; }
  /* Spacing is rem-based, so the root must shrink too — otherwise the type
     gets smaller while the whitespace stays screen-sized. */
  html { font-size: 9pt; }
  :root { --gutter: 6.5rem; }
  body { background: #fff; color: #000; font-size: 9.4pt; line-height: 1.42; }
  .toolbar { display: none; }
  .page { max-width: none; padding: 0; }
  .masthead { margin-bottom: 1.2rem; }
  .masthead h1 { font-size: 20pt; }
  .headline { font-size: 11pt; margin-bottom: 0.5rem; }
  .contact { font-size: 7.6pt; margin-bottom: 0.15rem; }
  section { margin-bottom: 1rem; }
  section > h2 { font-size: 8.4pt; margin-bottom: 0.5rem; padding-bottom: 0.22rem; color: #1f4e79; }
  .entry { margin-bottom: 0.6rem; gap: 0 1rem; }
  .primary { font-size: 9.8pt; }
  .sub { font-size: 8.4pt; }
  .when { font-size: 8pt; }
  .bullets { margin-top: 0.2rem; }
  .bullets li { margin-bottom: 0.1rem; }
  .group { margin-top: 0.45rem; }
  .child { margin-bottom: 0.45rem; }
  /* The measure that keeps prose readable on screen wastes ~2in of paper. */
  .what { max-width: none; }
  /* Never avoid breaks on a section — Experience is longer than a page and the
     rule only pushes it, leaving the previous page half empty. */
  .entry, .child { break-inside: avoid; }
  section > h2 { break-after: avoid; }
  a.ref, .contact a { color: #1f4e79; }
}
</style>
</head>
<body>

<div class="page">

  <div class="toolbar">
    <div class="seg" role="group" aria-label="Bahasa / Language">
      <button type="button" data-set="lang" data-value="en" aria-pressed="true">EN</button>
      <button type="button" data-set="lang" data-value="id" aria-pressed="false">ID</button>
    </div>
    <div class="seg" role="group" aria-label="View">
      <button type="button" data-set="view" data-value="full" aria-pressed="true">Full CV</button>
      <button type="button" data-set="view" data-value="resume" aria-pressed="false">Résumé</button>
    </div>
    <button type="button" class="iconbtn" id="theme-toggle" aria-label="Toggle theme">
      <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/></svg>
    </button>
    <span class="spacer"></span>
    <a class="toollink" href="../">← <span data-t="id">Beranda</span><span data-t="en">Home</span></a>
  </div>

{%- macro when(e, lang) -%}
  {%- if e.meta %}{{ e.meta[lang] }}{% endif -%}
{%- endmacro -%}

{%- macro refs(e) -%}
  {%- for u in e.links %}<div><a class="ref" href="{{ u }}" target="_blank" rel="noopener">{{ u }}</a></div>{% endfor -%}
{%- endmacro -%}

{% for lang in langs %}
  <article class="doc" data-doc-lang="{{ lang }}" lang="{{ lang }}">

    <header class="masthead">
      <h1>{{ meta.name }}</h1>
      <p class="headline">{{ meta.headline[lang] }}</p>
      <div class="contact">
        <span>{{ meta.location[lang] }}</span>
        {%- if meta.phone %}<span>{{ meta.phone }}</span>{% endif %}
        <a href="mailto:{{ meta.email }}">{{ meta.email }}</a>
        {%- for e in meta.emails_alt %}<a href="mailto:{{ e }}">{{ e }}</a>{% endfor %}
      </div>
      <div class="contact">
        {%- for name, url in meta.links.items() %}<a href="{{ url }}" target="_blank" rel="noopener">{{ name }}</a>{% endfor %}
      </div>
    </header>

    {% for s in sections %}
    <section data-section="{{ s.key }}">
      <h2>{{ s.title[lang] }}</h2>
      {% for e in s.entries %}
        {%- if e.style == 'line' %}
        <div class="entry flat{{ ' summary' if s.key == 'summary' }}" data-tier="{{ e.tier }}">
          <div class="when">{{ when(e, lang) }}</div>
          <div class="what">{{ e.runs[lang] | runs_html }}{{ refs(e) }}</div>
        </div>
        {%- else %}
        <div class="entry" data-tier="{{ e.tier }}">
          <div class="when">{{ when(e, lang) }}</div>
          <div class="what">
            <h3 class="primary">{{ e.primary[lang] }}</h3>
            {%- if e.sub and e.sub[lang] %}<p class="sub">{{ e.sub[lang] }}</p>{% endif %}
            {%- if e.bullets.get(lang) %}
            <ul class="bullets">
              {%- for b in e.bullets[lang] %}<li>{{ b }}</li>{% endfor %}
            </ul>
            {%- endif %}
            {{ refs(e) }}
            {%- if e.children %}
            <div class="group">
              <h4>{{ e.group_label[lang] }}</h4>
              {%- for c in e.children %}
              <div class="child" data-tier="{{ c.tier }}">
                <div class="when">{{ when(c, lang) }}</div>
                <h3 class="primary">{{ c.primary[lang] }}</h3>
                {%- if c.bullets.get(lang) %}
                <ul class="bullets">
                  {%- for b in c.bullets[lang] %}<li>{{ b }}</li>{% endfor %}
                </ul>
                {%- endif %}
                {{ refs(c) }}
              </div>
              {%- endfor %}
            </div>
            {%- endif %}
          </div>
        </div>
        {%- endif %}
      {% endfor %}
    </section>
    {% endfor %}

  </article>
{% endfor %}

</div>

<script>
(function () {
  var root = document.documentElement;
  var defaults = { lang: 'en', view: 'full' };

  function read(key) {
    try { return localStorage.getItem('cv.' + key); } catch (e) { return null; }
  }
  function write(key, value) {
    try { localStorage.setItem('cv.' + key, value); } catch (e) { /* private mode */ }
  }

  function apply(key, value) {
    root.setAttribute('data-' + key, value);
    document.querySelectorAll('[data-set="' + key + '"]').forEach(function (b) {
      b.setAttribute('aria-pressed', String(b.dataset.value === value));
    });
    if (key === 'lang') {
      root.setAttribute('lang', value);
      var t = document.getElementById('theme-toggle');
      if (t) t.setAttribute('aria-label', value === 'id' ? 'Ganti tema' : 'Toggle theme');
    }
  }

  Object.keys(defaults).forEach(function (key) {
    apply(key, read(key) || defaults[key]);
  });

  var stored = read('theme');
  if (stored) root.setAttribute('data-theme', stored);

  document.querySelectorAll('[data-set]').forEach(function (b) {
    b.addEventListener('click', function () {
      apply(b.dataset.set, b.dataset.value);
      write(b.dataset.set, b.dataset.value);
    });
  });

  document.getElementById('theme-toggle').addEventListener('click', function () {
    var dark = root.getAttribute('data-theme') === 'dark' ||
      (!root.getAttribute('data-theme') &&
        window.matchMedia('(prefers-color-scheme: dark)').matches);
    var next = dark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    write('theme', next);
  });

  // The page carries both languages, so a section key cannot be a DOM id
  // without duplicating it. Resolve #talks (etc.) against the visible article.
  function jumpToHash() {
    var key = location.hash.slice(1);
    if (!key) return;
    var lang = root.getAttribute('data-lang') || 'en';
    var el = document.querySelector(
      '.doc[data-doc-lang="' + lang + '"] section[data-section="' + key + '"]');
    if (el) el.scrollIntoView();
  }
  jumpToHash();
  window.addEventListener('hashchange', jumpToHash);
})();
</script>
</body>
</html>
